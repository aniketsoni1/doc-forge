{
  "name": "docforge-vscode",
  "displayName": "DocForge - Document Generator",
  "description": "Generate polished Markdown or HTML documents from a prompt - using your available AI, with an always-on offline fallback.",
  "version": "0.1.1",
  "private": true,
  "type": "commonjs",
  "publisher": "AniketSoni",
  "license": "Apache-2.0",
  "author": "aniketsoni1",
  "homepage": "https://github.com/aniketsoni1/doc-forge#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/aniketsoni1/doc-forge.git",
    "directory": "apps/vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/aniketsoni1/doc-forge/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Formatters",
    "Machine Learning"
  ],
  "keywords": [
    "markdown",
    "html",
    "document generator",
    "readme",
    "ai",
    "copilot",
    "template"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "main": "./dist/extension.cjs",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted workspaces DocForge uses only the offline template generator (no AI, no network)."
    }
  },
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "docforge.newDocument",
        "title": "DocForge: New Document from Prompt",
        "category": "DocForge"
      },
      {
        "command": "docforge.setApiKey",
        "title": "DocForge: Set API Key",
        "category": "DocForge"
      },
      {
        "command": "docforge.clearApiKey",
        "title": "DocForge: Clear API Key",
        "category": "DocForge"
      },
      {
        "command": "docforge.runDiagnostics",
        "title": "DocForge: Run Diagnostics",
        "category": "DocForge"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "docforge.setApiKey",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "docforge.clearApiKey",
          "when": "isWorkspaceTrusted"
        }
      ],
      "editor/context": [
        {
          "command": "docforge.newDocument",
          "group": "docforge@1",
          "when": "editorLangId =~ /^(markdown|html|plaintext)$/"
        }
      ]
    },
    "keybindings": [
      {
        "command": "docforge.newDocument",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d"
      }
    ],
    "configuration": [
      {
        "title": "Generation",
        "order": 1,
        "properties": {
          "docforge.defaultFormat": {
            "type": "string",
            "enum": [
              "md",
              "html"
            ],
            "enumDescriptions": [
              "Markdown source (.md)",
              "Sanitized, themed, printable HTML (.html)"
            ],
            "default": "md",
            "order": 1,
            "description": "Default output format for new documents."
          },
          "docforge.tone": {
            "type": "string",
            "enum": [
              "neutral",
              "formal",
              "friendly",
              "technical",
              "marketing"
            ],
            "default": "neutral",
            "order": 2,
            "description": "Default document tone."
          },
          "docforge.length": {
            "type": "string",
            "enum": [
              "short",
              "medium",
              "long"
            ],
            "enumDescriptions": [
              "One paragraph per section",
              "Two paragraphs per section",
              "Three paragraphs per section, plus extra sections"
            ],
            "default": "medium",
            "order": 3,
            "description": "Default document length."
          }
        }
      },
      {
        "title": "Providers",
        "order": 2,
        "properties": {
          "docforge.enableAi": {
            "type": "boolean",
            "default": true,
            "order": 1,
            "description": "Allow AI generators (VS Code LM API, compatible extensions, BYO key). When off, DocForge uses the offline template generator only. Untrusted workspaces always force templates regardless of this setting."
          },
          "docforge.provider": {
            "type": "string",
            "enum": [
              "anthropic",
              "openai"
            ],
            "default": "anthropic",
            "order": 2,
            "description": "Provider for the bring-your-own-key generator. Set the key with the command \"DocForge: Set API Key\" - it is stored in SecretStorage, never in settings."
          },
          "docforge.model": {
            "type": "string",
            "default": "claude-3-5-sonnet-latest",
            "order": 3,
            "description": "Model id for the bring-your-own-key generator.",
            "examples": [
              "claude-3-5-sonnet-latest",
              "claude-3-5-haiku-latest",
              "gpt-4o-mini",
              "gpt-4o"
            ]
          },
          "docforge.requestTimeoutMs": {
            "type": "integer",
            "default": 60000,
            "minimum": 1000,
            "maximum": 600000,
            "order": 4,
            "description": "Abort a bring-your-own-key request after this many milliseconds."
          }
        }
      },
      {
        "title": "Reporting",
        "order": 3,
        "properties": {
          "docforge.pricing": {
            "type": "object",
            "default": {},
            "order": 1,
            "markdownDescription": "Override the built-in indicative prices used for cost estimates, keyed by model-id prefix. Costs shown by DocForge are **always estimates**, never a bill.\n\nExample:\n```json\n{ \"claude-3-5-sonnet\": { \"inputPerMTok\": 3, \"outputPerMTok\": 15 } }\n```",
            "additionalProperties": {
              "type": "object",
              "required": [
                "inputPerMTok",
                "outputPerMTok"
              ],
              "properties": {
                "inputPerMTok": {
                  "type": "number",
                  "minimum": 0,
                  "description": "USD per million input tokens."
                },
                "outputPerMTok": {
                  "type": "number",
                  "minimum": 0,
                  "description": "USD per million output tokens."
                }
              }
            }
          }
        }
      }
    ]
  },
  "scripts": {
    "build": "node ./esbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "vscode:prepublish": "node ./esbuild.mjs --production"
  },
  "dependencies": {},
  "devDependencies": {}
}
